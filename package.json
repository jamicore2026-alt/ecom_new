{
  "name": "merchant-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant e-commerce merchant dashboard monorepo (API + UI) built with Turborepo + Bun",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@merchant-dashboard/api",
    "dev:web": "turbo run dev --filter=@merchant-dashboard/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@merchant-dashboard/web",
    "check": "turbo run check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@merchant-dashboard/api",
    "db:migrate": "turbo run db:migrate --filter=@merchant-dashboard/api",
    "db:seed": "turbo run db:seed --filter=@merchant-dashboard/api",
    "db:studio": "turbo run db:studio --filter=@merchant-dashboard/api"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  },
  "packageManager": "bun@1.3.14"
}
