PORT=3005
# Platform / admin connection (BYBYPASSRLS role `app_admin`; jobs, bootstrap,
# pre-auth lookups). Falls back to DATABASE_URL when unset.
# APP_ADMIN_DATABASE_URL=postgres://app_admin:app_admin_dev_password@localhost:5432/ecom_merchant
# Request-scoped tenant connection (role `app_runtime`, NO BYPASSRLS) so Row
# Level Security filters every merchant query. REQUIRED for RLS to be honored.
# See apps/api/drizzle/0029_manual_role_setup.sql to create the roles.
# APP_RUNTIME_DATABASE_URL=postgres://app_runtime:app_runtime_dev_password@localhost:5432/ecom_merchant
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecom_merchant
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Separate signing key for shopper (storefront) JWTs — REQUIRED in production
SHOPPER_ACCESS_SECRET=dev-shopper-secret-change-me

# AES-256-GCM key used to encrypt merchant payment provider credentials (BYOK) — REQUIRED in production
ENCRYPTION_KEY=dev-encryption-key-change-me

# Public URLs used to build payment gateway callback/webhook links
# PUBLIC_API_URL=http://localhost:3005
# PUBLIC_STOREFRONT_URL=http://localhost:5479

# Comma-separated list of allowed browser origins (defaults to localhost:5478/5479 in dev)
# CORS_ORIGINS=https://dashboard.example.com,https://jamicore-store.example.com

# --- S3/MinIO file storage (set STORAGE_DRIVER=s3 to enable) ---
# STORAGE_DRIVER=local          # default; set to "s3" to use MinIO/S3
# S3_ENDPOINT=s3.jamicore.com   # hostname only, no protocol
# S3_BUCKET=jamicore-uploads
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=us-east-1

# Rate limiting: honor x-forwarded-for (default true — API sits behind the
# vite dev proxy / Coolify Traefik). Set false only if the API port is
# exposed directly to the internet.
# TRUST_PROXY=true

# Rate limiting backend. Default is in-memory (single-node, in-process).
# Setting REDIS_URL ALONE auto-enables the shared Redis store (across multiple
# API instances); RATE_LIMIT_STORE is an optional explicit override
# (memory|redis) to force either one. Uses a built-in minimal RESP client.
# If Redis is unreachable at boot the API logs a warning and falls back to the
# in-memory store rather than failing to start.
# RATE_LIMIT_STORE=memory
# REDIS_URL=redis://user:pass@localhost:6379/0   # redis:// or rediss://

# --- Production (Coolify): api.jamicore.com / merchant.jamicore.com / store.jamicore.com ---
# API service:      DATABASE_URL, JWT_* secrets, ENCRYPTION_KEY, NODE_ENV=production,
#                   PUBLIC_API_URL=https://api.jamicore.com,
#                   PUBLIC_STOREFRONT_URL=https://store.jamicore.com,
#                   CORS_ORIGINS=https://merchant.jamicore.com,https://store.jamicore.com
# Web + storefront services (runtime proxy target for /api and /uploads — NOT a build arg):
#                   API_ORIGIN=https://api.jamicore.com
# Storefront also needs (baked at build time via Dockerfile ARGs):
#                   PUBLIC_API_URL=https://api.jamicore.com,
#                   PUBLIC_STOREFRONT_URL=https://store.jamicore.com,
#                   PUBLIC_DEFAULT_STORE=jamicore-store

# Storefront (apps/storefront) — default store slug for `/`
PUBLIC_DEFAULT_STORE=jamicore-store
